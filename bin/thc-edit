#!/bin/sh
# Keep this launcher beside hide; THC discovers it as the external edit command.
set -eu
launcher=$0
case $launcher in */*) ;; *) launcher=$(command -v "$launcher") ;; esac
while [ -L "$launcher" ]; do
  directory=$(CDPATH= cd -- "$(dirname -- "$launcher")" && pwd)
  target=$(readlink "$launcher")
  case $target in /*) launcher=$target ;; *) launcher=$directory/$target ;; esac
done
directory=$(CDPATH= cd -- "$(dirname -- "$launcher")" && pwd)
exec "$directory/hide" "$@"

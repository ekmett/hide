cabal-version: 3.0
-- SPDX-FileCopyrightText: 2026 Edward Kmett
-- SPDX-License-Identifier: BSD-2-Clause OR Apache-2.0
name: hide-agents
version: 0.1.0.0
synopsis: First-party agent directory plugin for hide
license: BSD-2-Clause OR Apache-2.0
license-files: LICENSE-BSD-2-Clause.md, LICENSE-APACHE.md
build-type: Simple

library
  default-language: Haskell2010
  ghc-options: -Wall
  hs-source-dirs: src
  exposed-modules: Hide.AgentUI, Hide.AgentTools, Hide.AgentTranscript, Hide.CompletionInput, Hide.ConversationInput, Hide.ConversationMenus, Hide.ConversationChoices, Hide.DocsTools, Hide.EnvironmentTools, Hide.BufferTools, Hide.AgentSettingsTools, Hide.QuestionTools, Hide.TerminalTools
  other-modules: Hide.AgentConfigurationForms
  build-depends: base >=4.18 && <4.23, hide-plugin-api ==0.1.0.0, hide-agent-api ==0.1.0.0
    , text >=2.0, aeson, async, bytestring, deepseq, containers

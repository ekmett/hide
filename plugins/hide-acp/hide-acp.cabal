cabal-version: 3.0
-- SPDX-FileCopyrightText: 2026 Edward Kmett
-- SPDX-License-Identifier: BSD-2-Clause OR Apache-2.0
name: hide-acp
version: 0.1.0.0
synopsis: Linked ACP transport and agent provider for hide
license: BSD-2-Clause OR Apache-2.0
license-files: LICENSE.md
build-type: Simple

library
  default-language: GHC2021
  ghc-options: -Wall
  hs-source-dirs: src
  exposed-modules: Hide.ACP, Hide.AgentACP, Hide.AutocompleteACP
  build-depends: base >=4.18 && <4.23, hide-agent-api ==0.1.0.0,
    text >=2.0, containers, bytestring, directory, process, async, stm, aeson, vector

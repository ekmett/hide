cabal-version: 3.0
name: thc-edit
version: 0.1.0.0
synopsis: Turbo Haskell's terminal editor
build-type: Simple
data-files: docs/*.md, docs/design/*.md, docs/plans/*.md, skills/debug-editor/SKILL.md, assets/web/*.html, assets/web/*.js, README.md, assets/fonts/*.hex, assets/fonts/*.txt, assets/fonts/README.md
extra-source-files: docs/*.md, docs/design/*.md, docs/plans/*.md, cbits/remote.h, test/editor-session.py, test/daemon-session.py, test/session-recovery.py, test/remote-browser.py, test/remote-session.py, tools/web-wire-trial.hs, test/web-wire.mjs, tools/web-bandwidth.hs, tools/web-bandwidth.py, assets/icons/*.svg, tools/convert-material-icons.py, cbits/window.h, cbits/unicode.h, tools/convert-font.py, tools/check-native.sh, test/native-input.c, cbits/terminal.h, test/native-terminal.c, test/HighlightBench.hs, test/HLSLive.hs, test/EditorLive.hs, test/dap-session.py

flag window
  description: Build the optional SDL3 Metal/Vulkan frontend
  default: True
  manual: True

flag web
  description: Build the optional local browser/WebGL frontend
  default: True
  manual: True

flag remote
  description: Compatibility flag; persistent local and SSH sessions are always built
  default: True
  manual: True

flag terminal
  description: Build the optional libghostty-vt embedded terminal
  default: True
  manual: True

common settings
  default-language: GHC2021
  ghc-options: -Wall
  build-depends: base >=4.18 && <4.23, text, containers, bytestring, directory, filepath, time, process, vty >=6.0, vty-crossplatform

library
  import: settings
  build-depends: toml-parser >=2.0 && <2.1, JuicyPixels, base64-bytestring, blaze-builder, network, async, stm, skylighting >=0.15 && <0.16, aeson, vector, fingertree >=0.1.5 && <0.2, commonmark >=0.3 && <0.4, commonmark-extensions >=0.2 && <0.3
  c-sources: cbits/unicode.c
  include-dirs: cbits
  pkgconfig-depends: libutf8proc >=2.10
  hs-source-dirs: src
  other-modules: Paths_thc_edit
  autogen-modules: Paths_thc_edit
  exposed-modules: THC.Edit.AgentHub, THC.Edit.AgentACP, THC.Edit.AgentMCP, THC.Edit.AgentWorkspace, THC.Edit.Process, THC.Edit.Completion, THC.Edit.Build, THC.Edit.BuildJobs, THC.Edit.Protocol, THC.Edit.Remote, THC.Edit.RemoteWeb, THC.Edit.RemoteWindow, THC.Edit.Web, THC.Edit.Unicode, THC.Edit.Buffer, THC.Edit.Syntax, THC.Edit.Model, THC.Edit.Render, THC.Edit.Files, THC.Edit.App, THC.Edit.Frontend, THC.Edit.Window, THC.Edit.Browser, THC.Edit.Help, THC.Edit.Git, THC.Edit.GitOperations, THC.Edit.LSP, THC.Edit.Tooling, THC.Edit.External, THC.Edit.Reconcile, THC.Edit.ACP, THC.Edit.AgentFiles, THC.Edit.Conversation, THC.Edit.Markdown, THC.Edit.Terminal, THC.Edit.Consoles, THC.Edit.DAP, THC.Edit.Debugger, THC.Edit.Hex
  if flag(web)
    cpp-options: -DWITH_WEB
    other-modules: THC.Edit.BrowserServer
    build-depends: wai, warp, wai-websockets, websockets >=0.13, http-types
  cpp-options: -DWITH_REMOTE
  exposed-modules: THC.Edit.GuestAccess, THC.Edit.ClipboardMCP, THC.Edit.DocsMCP, THC.Edit.Defaults, THC.Edit.ControlMCP, THC.Edit.MCPPermissions, THC.Edit.RemoteEndpoint, THC.Edit.EditorMCP, THC.Edit.WorkspaceFilesMCP, THC.Edit.TestsMCP, THC.Edit.HistoryMCP, THC.Edit.RuntimeMCP, THC.Edit.ScreenCapture, THC.Edit.WorkspaceMCP, THC.Edit.Session, THC.Edit.Recovery, THC.Edit.Font, THC.Edit.RemoteTerminal
  build-depends: zlib
  if os(windows)
    c-sources: cbits/remote.c
    extra-libraries: advapi32, ws2_32
  else
    build-depends: unix
  if flag(terminal) && !os(windows)
    cpp-options: -DWITH_TERMINAL
    c-sources: cbits/terminal.c
    include-dirs: cbits
    pkgconfig-depends: libghostty-vt
    if os(linux)
      extra-libraries: util
  if flag(window)
    cpp-options: -DWITH_WINDOW
    cc-options: -DWITH_WINDOW
    c-sources: cbits/window.c
    include-dirs: cbits
    pkgconfig-depends: sdl3 >=3.2
    if os(osx)
      c-sources: cbits/menu.m
      cc-options: -fobjc-arc
      frameworks: Cocoa, CoreText, CoreGraphics
    else
      extra-libraries: m
      pkgconfig-depends: pangocairo

executable thc-edit
  import: settings
  hs-source-dirs: app
  main-is: Main.hs
  build-depends: thc-edit
  ghc-options: -threaded -rtsopts

test-suite editor-tests
  import: settings
  if flag(web)
    cpp-options: -DWITH_WEB
    other-modules: WebCheck
    build-depends: zlib
  cpp-options: -DWITH_REMOTE -DWITH_PROTOCOL -DWITH_FONT
  other-modules: RecoveryCheck, GuestAccessCheck, StreamerCheck, ClipboardMCPCheck, DocsMCPCheck, ControlMCPCheck, DefaultsCheck, MCPPermissionsCheck, RemoteCheck, RemoteWindowCheck, RemoteTerminalCheck, ProtocolCheck, FontCheck, EditorMCPCheck, HistoryMCPCheck, RuntimeMCPCheck, ScreenCaptureCheck, WorkspaceMCPCheck, WorkspaceFilesMCPCheck, TestsMCPCheck
  build-depends: zlib
  if !os(windows)
    build-depends: unix
  ghc-options: -threaded
  other-modules: AgentHubCheck, AgentACPCheck, AgentMCPCheck, AgentWorkspaceCheck, CompletionCheck, BuildCheck, UnicodeCheck, HexCheck, DAPCheck, DebuggerCheck, RunCheck, ConversationCheck, AgentFilesCheck, TerminalCheck, ConsolesCheck, FilesCheck, WindowCheck, BrowserCheck, HelpCheck, GitCheck, GitOperationsCheck, LSPCheck, ToolingCheck, DialogMouseCheck, BufferTreeCheck, ExternalCheck, ReconcileCheck, ACPCheck, MarkdownCheck
  if flag(window)
    cpp-options: -DWITH_WINDOW
  if flag(terminal) && !os(windows)
    cpp-options: -DWITH_TERMINAL
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  build-depends: JuicyPixels, base64-bytestring, blaze-builder, thc-edit, aeson, vector, network, async, stm

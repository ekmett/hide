cabal-version: 3.0
name: thc-edit
version: 0.1.0.0
synopsis: Turbo Haskell's terminal editor
build-type: Simple
data-files: README.md, assets/fonts/*.hex, assets/fonts/*.txt, assets/fonts/README.md
extra-source-files: assets/icons/*.svg, tools/convert-material-icons.py, cbits/window.h, cbits/unicode.h, tools/convert-font.py, tools/check-native.sh, test/native-input.c, cbits/terminal.h, test/native-terminal.c, test/HighlightBench.hs, test/HLSLive.hs, test/EditorLive.hs, test/dap-session.py

flag window
  description: Build the optional SDL3 Metal/Vulkan frontend
  default: False
  manual: True

flag terminal
  description: Build the optional libghostty-vt embedded terminal
  default: False
  manual: True

common settings
  default-language: GHC2021
  ghc-options: -Wall
  build-depends: base >=4.18 && <4.23, text, containers, bytestring, directory, filepath, time, process, vty >=6.0, vty-crossplatform

library
  import: settings
  build-depends: blaze-builder, network, async, stm, skylighting >=0.15 && <0.16, aeson, vector, fingertree >=0.1.5 && <0.2, commonmark >=0.3 && <0.4
  c-sources: cbits/unicode.c
  include-dirs: cbits
  pkgconfig-depends: libutf8proc >=2.10
  hs-source-dirs: src
  other-modules: Paths_thc_edit
  autogen-modules: Paths_thc_edit
  exposed-modules: THC.Edit.Unicode, THC.Edit.Buffer, THC.Edit.Syntax, THC.Edit.Model, THC.Edit.Render, THC.Edit.Files, THC.Edit.App, THC.Edit.Frontend, THC.Edit.Window, THC.Edit.Browser, THC.Edit.Help, THC.Edit.Git, THC.Edit.GitOperations, THC.Edit.LSP, THC.Edit.Tooling, THC.Edit.External, THC.Edit.Reconcile, THC.Edit.ACP, THC.Edit.AgentFiles, THC.Edit.Conversation, THC.Edit.Markdown, THC.Edit.Terminal, THC.Edit.Consoles, THC.Edit.DAP, THC.Edit.Debugger, THC.Edit.Hex
  if flag(terminal)
    cpp-options: -DWITH_TERMINAL
    c-sources: cbits/terminal.c
    include-dirs: cbits
    pkgconfig-depends: libghostty-vt
    if os(linux)
      extra-libraries: util
  if flag(window)
    cpp-options: -DWITH_WINDOW
    cc-options: -DWITH_WINDOW
    exposed-modules: THC.Edit.Font
    c-sources: cbits/window.c
    include-dirs: cbits
    pkgconfig-depends: sdl3 >=3.2
    if os(osx)
      c-sources: cbits/menu.m
      cc-options: -fobjc-arc
      frameworks: Cocoa, CoreText, CoreGraphics
    else
      extra-libraries: m
      pkgconfig-depends: pangocairo

executable thc-edit
  import: settings
  hs-source-dirs: app
  main-is: Main.hs
  build-depends: thc-edit
  ghc-options: -threaded -rtsopts

test-suite editor-tests
  import: settings
  ghc-options: -threaded
  other-modules: UnicodeCheck, HexCheck, DAPCheck, DebuggerCheck, RunCheck, ConversationCheck, AgentFilesCheck, TerminalCheck, ConsolesCheck, FilesCheck, WindowCheck, BrowserCheck, HelpCheck, GitCheck, GitOperationsCheck, LSPCheck, ToolingCheck, DialogMouseCheck, BufferTreeCheck, ExternalCheck, ReconcileCheck, ACPCheck, MarkdownCheck
  if flag(window)
    cpp-options: -DWITH_WINDOW
    other-modules: FontCheck
  if flag(terminal)
    cpp-options: -DWITH_TERMINAL
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  build-depends: blaze-builder, thc-edit, aeson, network, async, stm

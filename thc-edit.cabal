cabal-version: 3.0
name: thc-edit
version: 0.1.0.0
synopsis: Turbo Haskell's terminal editor
build-type: Simple
data-files: assets/fonts/*.hex, assets/fonts/*.txt, assets/fonts/README.md
extra-source-files: cbits/window.h, tools/convert-font.py

flag window
  description: Build the optional SDL3 Metal/Vulkan frontend
  default: False
  manual: True

common settings
  default-language: GHC2021
  ghc-options: -Wall
  build-depends: base >=4.18 && <4.23, text, containers, bytestring, directory, filepath, time, vty >=6.0, vty-crossplatform

library
  import: settings
  hs-source-dirs: src
  exposed-modules: THC.Edit.Buffer, THC.Edit.Syntax, THC.Edit.Model, THC.Edit.Render, THC.Edit.Files, THC.Edit.App, THC.Edit.Frontend, THC.Edit.Window
  if flag(window)
    cpp-options: -DWITH_WINDOW
    exposed-modules: THC.Edit.Font
    other-modules: Paths_thc_edit
    autogen-modules: Paths_thc_edit
    c-sources: cbits/window.c
    include-dirs: cbits
    pkgconfig-depends: sdl3 >=3.2
    if os(osx)
      c-sources: cbits/menu.m
      cc-options: -fobjc-arc
      frameworks: Cocoa
    else
      extra-libraries: m

executable thc-edit
  import: settings
  hs-source-dirs: app
  main-is: Main.hs
  build-depends: thc-edit
  ghc-options: -threaded -rtsopts

test-suite editor-tests
  import: settings
  other-modules: FilesCheck, WindowCheck
  if flag(window)
    cpp-options: -DWITH_WINDOW
    other-modules: FontCheck
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  build-depends: thc-edit

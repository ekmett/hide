# Discover the checkout's Ghostty while retaining the system pkg-config database.
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(CDPATH= cd -- "$here/../.." && pwd)
export PKG_CONFIG_PATH="$root/.deps/ghostty/share/pkgconfig:$root/.deps/ghostty/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
# Cabal adds this directory to PATH for build tools. Skip ourselves when delegating.
remaining=$PATH
while :; do
  directory=${remaining%%:*}
  candidate=${directory:-.}/pkg-config
  if [ -x "$candidate" ] && ! [ "$candidate" -ef "$here/pkg-config" ]; then
    exec "$candidate" "$@"
  fi
  case $remaining in *:*) remaining=${remaining#*:} ;; *) break ;; esac
done
echo 'pkg-config is required on PATH' >&2
exit 127

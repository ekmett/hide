cabal-version: 3.0
name: hide-docs
version: 0.1.0.0
build-type: Simple

executable hide-docs
  main-is: Main.hs
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
    base >= 4.14 && < 5,
    containers,
    directory,
    filepath,
    process,
    tagsoup >= 0.14 && < 0.15,
    text

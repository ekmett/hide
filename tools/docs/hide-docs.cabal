cabal-version: 3.0
-- SPDX-FileCopyrightText: 2026 Edward Kmett
-- SPDX-License-Identifier: BSD-2-Clause OR Apache-2.0
name: hide-docs
synopsis: Build and check the hide documentation site
version: 0.1.0.0
build-type: Simple
license: BSD-2-Clause OR Apache-2.0
license-files: LICENSES/BSD-2-Clause.txt, LICENSES/Apache-2.0.txt

executable hide-docs
  main-is: Main.hs
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
    base >= 4.14 && < 5,
    containers,
    directory,
    filepath,
    process,
    tagsoup >= 0.14 && < 0.15,
    text

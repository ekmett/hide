cabal-version: 3.0
-- SPDX-FileCopyrightText: 2026 Edward Kmett
-- SPDX-License-Identifier: BSD-2-Clause OR Apache-2.0
name: hide-agent-api
version: 0.1.0.0
synopsis: Provider-neutral agent driver contract for hide
license: BSD-2-Clause OR Apache-2.0
license-files: LICENSE.md
build-type: Simple

library
  default-language: Haskell2010
  ghc-options: -Wall
  hs-source-dirs: src
  exposed-modules: Hide.Plugin.Provider, Hide.Plugin.Agent, Hide.Plugin.AgentDirectory, Hide.Plugin.AgentServices, Hide.Plugin.Completion, Hide.Plugin.ConversationInput, Hide.Plugin.ConversationSession, Hide.Plugin.AgentSettings
  build-depends: base >=4.18 && <4.23, text >=2.0, aeson

cabal-version: 3.0
name: hide-plugin-api
version: 0.1.0.0
synopsis: Scoped commands, forms and sidebar contracts for hide plugins
license: BSD-3-Clause
build-type: Simple

library
  default-language: Haskell2010
  ghc-options: -Wall
  hs-source-dirs: src
  exposed-modules: Hide.Plugin.Command, Hide.Plugin.Form, Hide.Plugin.Menu
    , Hide.Plugin.Tree, Hide.Plugin.Sidebar, Hide.Plugin.Session, Hide.Plugin.Tool
  other-modules: Hide.Plugin.Identity
  build-depends: base >=4.18 && <4.23, hide-agent-api ==0.1.0.0
    , text >=2.0, bytestring, aeson, deepseq, containers, stm, vector, entropy >=0.4.1.11 && <0.5

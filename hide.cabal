cabal-version: 3.0
name: hide
version: 0.1.0.0
synopsis: Haskell IDE for terminal, native window and browser
build-type: Simple
data-files: docs/site/screenshots/*.png, docs/*.md, docs/design/*.md, docs/plans/*.md, skills/debug-editor/SKILL.md, assets/web/*.html, assets/web/*.js, README.md, assets/fonts/*.hex, assets/fonts/*.txt, assets/fonts/README.md
extra-source-files: test/launchers.sh, bin/thc-edit, bin/th, bin/thc-edit.cmd, bin/th.cmd, tools/pkgconfig/pkg-config, docs/*.md, docs/design/*.md, docs/plans/*.md, cbits/remote.h, test/editor-session.py, test/daemon-session.py, test/interrupt-session.py, test/session-recovery.py, test/remote-browser.py, test/remote-session.py, tools/web-wire-trial.hs, test/web-wire.mjs, test/web-links.mjs, test/web-keybindings.mjs, tools/web-bandwidth.hs, tools/web-bandwidth.py, assets/icons/*.svg, tools/convert-material-icons.py, cbits/window.h, cbits/unicode.h, tools/convert-font.py, tools/check-native.sh, test/native-input.c, test/native-menu.m, cbits/terminal.h, test/native-terminal.c, test/native-terminal.hs, test/HighlightBench.hs, test/HLSLive.hs, test/EditorLive.hs, test/dap-session.py

flag window
  description: Build the optional SDL3 Metal/Vulkan frontend
  default: True
  manual: True

flag web
  description: Build the optional local browser/WebGL frontend
  default: True
  manual: True

flag remote
  description: Compatibility flag; persistent local and SSH sessions are always built
  default: True
  manual: True

flag terminal
  description: Build the optional libghostty-vt embedded terminal
  default: True
  manual: True

common settings
  default-language: GHC2021
  ghc-options: -Wall
  build-depends: base >=4.18 && <4.23, text, containers, bytestring, directory, filepath, time, process, vty >=6.0, vty-crossplatform

library
  import: settings
  build-depends: Cabal-syntax >=3.16 && <3.17, deepseq, network-uri, toml-parser >=2.0 && <2.1, JuicyPixels, base64-bytestring, blaze-builder, network, async, stm, skylighting >=0.15 && <0.16, aeson, vector, fingertree >=0.1.5 && <0.2, commonmark >=0.3 && <0.4, commonmark-extensions >=0.2 && <0.3
  c-sources: cbits/unicode.c
  include-dirs: cbits
  pkgconfig-depends: libutf8proc >=2.10
  hs-source-dirs: src
  other-modules: Paths_hide
  autogen-modules: Paths_hide
  exposed-modules: Hide.SessionSidebar, Hide.SessionSidebarTypes, Hide.AgentSidebar, Hide.AgentSidebarTypes, Hide.BufferEdits, Hide.BufferReadAdmission, Hide.BufferReadCommand, Hide.BufferDiffCommand, Hide.BufferReads, Hide.Plugin.Window, Hide.PluginWindowHost, Hide.Plugin.Buffer, Hide.Plugin.BufferHost, Hide.Plugin.Command, Hide.Plugin.Tree, Hide.Sidebar, Hide.SidebarCommands, Hide.Plugin.Menu, Hide.Documentation, Hide.Commands, Hide.Bindings, Hide.Keybindings, Hide.InlineTypes, Hide.InlineState, Hide.AutocompleteConfig, Hide.Autocomplete, Hide.AutocompleteACP, Hide.Copilot, Hide.AgentAccess, Hide.AgentRuntime, Hide.AgentHub, Hide.AgentACP, Hide.AgentMCP, Hide.AgentWorkspace, Hide.Process, Hide.Completion, Hide.Build, Hide.Compilers, Hide.Downloads, Hide.HdbAcquisition, Hide.CabalPlan, Hide.PackageSources, Hide.PackagePaths, Hide.PackageSidebar, Hide.ProjectBrowser, Hide.BuildJobs, Hide.Protocol, Hide.Remote, Hide.RemoteWeb, Hide.RemoteWindow, Hide.Web, Hide.Unicode, Hide.Buffer, Hide.BufferView, Hide.Syntax, Hide.Highlighting, Hide.Model, Hide.Render, Hide.Files, Hide.App, Hide.Frontend, Hide.Window, Hide.Browser, Hide.Help, Hide.Git, Hide.GitOperations, Hide.LSP, Hide.Tooling, Hide.External, Hide.Reconcile, Hide.ACP, Hide.AgentFiles, Hide.Conversation, Hide.Markdown, Hide.Terminal, Hide.Consoles, Hide.DAP, Hide.Debugger, Hide.DebuggerSidebar, Hide.DebuggerSidebarTypes, Hide.Hex
  if flag(web)
    cpp-options: -DWITH_WEB
    other-modules: Hide.BrowserServer
    build-depends: wai, warp, wai-websockets, websockets >=0.13, http-types
  cpp-options: -DWITH_REMOTE
  exposed-modules: Hide.Links, Hide.Environment, Hide.GuestAccess, Hide.ClipboardMCP, Hide.DocsMCP, Hide.MenuCommands, Hide.Defaults, Hide.ControlMCP, Hide.MCPPermissions, Hide.RemoteEndpoint, Hide.EditorMCP, Hide.WorkspaceFilesMCP, Hide.TestsMCP, Hide.HistoryMCP, Hide.RuntimeMCP, Hide.ScreenCapture, Hide.WorkspaceMCP, Hide.Session, Hide.Recovery, Hide.Font, Hide.RemoteTerminal
  build-depends: zlib
  if os(windows)
    c-sources: cbits/remote.c
    extra-libraries: advapi32, ws2_32
  else
    build-depends: unix
  if flag(terminal)
    cpp-options: -DWITH_TERMINAL
    c-sources: cbits/terminal.c
    include-dirs: cbits
    pkgconfig-depends: libghostty-vt
    if os(linux)
      extra-libraries: util
  if flag(window)
    cpp-options: -DWITH_WINDOW
    cc-options: -DWITH_WINDOW
    c-sources: cbits/window.c
    include-dirs: cbits
    pkgconfig-depends: sdl3 >=3.2
    if os(osx)
      c-sources: cbits/menu.m
      cc-options: -fobjc-arc
      frameworks: Cocoa, CoreText, CoreGraphics
    else
      extra-libraries: m
      pkgconfig-depends: pangocairo

executable hide
  import: settings
  hs-source-dirs: app
  main-is: Main.hs
  build-depends: hide
  ghc-options: -threaded -rtsopts

test-suite editor-tests
  import: settings
  build-depends: Cabal-syntax >=3.16 && <3.17
  other-modules: PackageSourcesCheck, PackagePathsCheck, PackageSidebarCheck
  if flag(web)
    cpp-options: -DWITH_WEB
    other-modules: WebCheck
    build-depends: zlib
  cpp-options: -DWITH_REMOTE -DWITH_PROTOCOL -DWITH_FONT
  other-modules: LinksCheck, EnvironmentCheck, RecoveryCheck, GuestAccessCheck, StreamerCheck, ClipboardMCPCheck, DocsMCPCheck, ControlMCPCheck, DefaultsCheck, MCPPermissionsCheck, RemoteCheck, RemoteWindowCheck, RemoteTerminalCheck, ProtocolCheck, FontCheck, EditorMCPCheck, HistoryMCPCheck, RuntimeMCPCheck, ScreenCaptureCheck, WorkspaceMCPCheck, WorkspaceFilesMCPCheck, TestsMCPCheck
  build-depends: zlib
  if !os(windows)
    build-depends: unix
  ghc-options: -threaded
  other-modules: SessionSidebarCheck, PluginWindowsCheck, SourceWindowFixture, WindowExtension, AgentSidebarCheck, TypedBufferDiffsCheck, TypedBufferReadsCheck, WorkerDiffCheck, BufferEditsCheck, BufferReadsCheck, PluginBufferCheck, PluginCommandCheck, PluginTreeCheck, SidebarCheck, SidebarFixture, TreeExtension, PluginMenuCheck, MenuExtension, MenuCommandsCheck, MenuContextCheck, BindingsCheck, HintComposerCheck, AutocompleteCheck, InlineCheck, InlineRenderCheck, AutocompleteACPCheck, CopilotCheck, HighlightingCheck, AgentIntegrationCheck, AgentAccessCheck, AgentRuntimeCheck, AgentHubCheck, AgentACPCheck, AgentMCPCheck, AgentWorkspaceCheck, CompletionCheck, CompilersCheck, DownloadsCheck, HdbAcquisitionCheck, DebuggerAcquisitionCheck, BuildCheck, ProjectBrowserCheck, UnicodeCheck, HexCheck, DAPCheck, DebuggerCheck, DebuggerSidebarCheck, DebuggerSourcePolicyCheck, RunCheck, ConversationCheck, AgentFilesCheck, TerminalCheck, ConsolesCheck, FilesCheck, WindowCheck, BrowserCheck, HelpCheck, GitCheck, GitOperationsCheck, LSPCheck, ToolingCheck, DialogMouseCheck, BufferViewCheck, BufferTreeCheck, ExternalCheck, ReconcileCheck, ACPCheck, MarkdownCheck
  if flag(window)
    cpp-options: -DWITH_WINDOW
  if flag(terminal)
    cpp-options: -DWITH_TERMINAL
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  build-depends: JuicyPixels, base64-bytestring, blaze-builder, hide, aeson, vector, network, async, stm
